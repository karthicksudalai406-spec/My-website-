<!DOCTYPE html>
<html lang="ta">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Home Account</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#10131a;
  color:white;
}
header{
  background:#171e2b;
  padding:18px;
  text-align:center;
  font-size:23px;
  font-weight:bold;
}
nav{
  display:flex;
  flex-wrap:wrap;
  background:#202938;
  position:sticky;
  top:0;
  z-index:5;
}
nav button{
  flex:1;
  min-width:70px;
  padding:13px 5px;
  border:0;
  background:transparent;
  color:white;
  font-size:13px;
}
nav button.active{background:#1677ff}
main{padding:14px;max-width:650px;margin:auto}
.page{display:none}
.page.active{display:block}
.box{
  background:#1b2331;
  padding:16px;
  margin:12px 0;
  border-radius:14px;
}
h2{font-size:21px}
h3{margin-top:0}
label{display:block;margin:12px 0 6px}
input,select,textarea{
  width:100%;
  padding:12px;
  border-radius:8px;
  border:1px solid #414b5d;
  background:#101722;
  color:white;
  font-size:16px;
}
textarea{resize:vertical}
button{
  cursor:pointer;
}
.primary,.danger,.secondary{
  padding:12px;
  border:0;
  border-radius:8px;
  color:white;
  font-size:15px;
}
.primary{background:#1677ff}
.danger{background:#d93649}
.secondary{background:#39465a}
.full{width:100%;margin-top:14px}
.cards{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}
.card{
  padding:15px;
  border-radius:12px;
  background:#202c40;
  overflow-wrap:anywhere;
}
.card small{color:#c1cde0}
.card strong{
  display:block;
  margin-top:8px;
  font-size:22px;
  overflow-wrap:anywhere;
}
.green{color:#54e29a}
.red{color:#ff7d89}
.blue{color:#7db5ff}
.entry{
  background:#253043;
  padding:13px;
  border-radius:10px;
  margin:10px 0;
  overflow-wrap:anywhere;
}
.entry button{margin:7px 5px 0 0}
.muted{color:#bac5d5;font-size:13px}
.row{display:flex;gap:8px}
.row>*{flex:1;min-width:0}
.result{white-space:pre-wrap;overflow-wrap:anywhere}
hr{border:0;border-top:1px solid #3a4556;margin:14px 0}
</style>
</head>

<body>

<header>🏠 My Home Account</header>

<nav>
  <button class="active" data-page="home">🏠 Home</button>
  <button data-page="add">➕ Add</button>
  <button data-page="history">📋 History</button>
  <button data-page="calculator">🧮 Calculator</button>
  <button data-page="backup">💾 Backup</button>
</nav>

<main>

<!-- HOME -->
<section id="home" class="page active">
  <h2>🏠 Home Dashboard</h2>

  <div class="cards">
    <div class="card">
      <small>💰 மொத்த வரவு</small>
      <strong class="green" id="incomeTotal">₹0.00</strong>
    </div>
    <div class="card">
      <small>💸 மொத்த செலவு</small>
      <strong class="red" id="expenseTotal">₹0.00</strong>
    </div>
    <div class="card" style="grid-column:1/-1">
      <small>💵 மீதித் தொகை (Balance)</small>
      <strong class="blue" id="balanceTotal">₹0.00</strong>
    </div>
  </div>

  <div class="box">
    <h3>🔍 கணக்குகளைத் தேடுங்கள்</h3>
    <input id="homeSearch" type="search"
      placeholder="பெயர், விவரம் அல்லது தேதி...">
    <div id="homeSearchResults"></div>
  </div>

  <div class="box">
    <h3>📅 தேதி வாரியான கணக்கு</h3>
    <label>தொடக்க தேதி</label>
    <input id="startDate" type="date">
    <label>முடிவு தேதி</label>
    <input id="endDate" type="date">
    <button class="primary full" id="reportBtn">கணக்கைப் பார்க்க</button>
    <div id="reportResult" class="result"></div>
  </div>

  <div class="box">
    <h3>🕒 சமீபத்திய கணக்குகள்</h3>
    <div id="recentEntries"></div>
  </div>
</section>

<!-- ADD ACCOUNT -->
<section id="add" class="page">
  <h2>➕ புதிய கணக்கு சேர்க்க</h2>

  <div class="box">
    <form id="accountForm">
      <label>பெயர்</label>
      <input id="person" type="text" placeholder="பெயரை type செய்யுங்கள்" required>

      <label>கணக்கு வகை</label>
      <select id="type">
        <option value="income">வரவு (Income)</option>
        <option value="expense">செலவு (Expense)</option>
      </select>

      <label>விவரம்</label>
      <input id="description" type="text" placeholder="எதற்கான கணக்கு?" required>

      <label>தொகை (₹)</label>
      <input id="amount" type="number" min="0.01" step="0.01"
        placeholder="தொகையை type செய்யுங்கள்" required>

      <label>தேதி</label>
      <input id="date" type="date" required>

      <label>குறிப்புகள்</label>
      <textarea id="notes" rows="3" placeholder="விருப்பப்பட்டால் எழுதுங்கள்"></textarea>

      <button class="primary full" type="submit">💾 கணக்கைச் சேமிக்க</button>
    </form>
  </div>
</section>

<!-- HISTORY -->
<section id="history" class="page">
  <h2>📋 கணக்கு History</h2>

  <div class="box">
    <label>தேடல்</label>
    <input id="historySearch" type="search" placeholder="பெயர் அல்லது விவரம்...">

    <label>கணக்கு வகை</label>
    <select id="historyType">
      <option value="all">அனைத்தும்</option>
      <option value="income">வரவு மட்டும்</option>
      <option value="expense">செலவு மட்டும்</option>
    </select>

    <label>மாதம்</label>
    <input id="historyMonth" type="month">
  </div>

  <div id="historyEntries"></div>
</section>

<!-- CALCULATOR -->
<section id="calculator" class="page">
  <h2>🧮 Calculator</h2>

  <div class="box">
    <label>முதல் எண்</label>
    <input id="num1" type="number" step="any" placeholder="முதல் எண்">

    <label>செயல்</label>
    <select id="operator">
      <option value="+">கூட்டல் (+)</option>
      <option value="-">கழித்தல் (-)</option>
      <option value="*">பெருக்கல் (×)</option>
      <option value="/">வகுத்தல் (÷)</option>
    </select>

    <label>இரண்டாவது எண்</label>
    <input id="num2" type="number" step="any" placeholder="இரண்டாவது எண்">

    <button class="primary full" id="calculateBtn">= கணக்கிடு</button>
    <div class="card" style="margin-top:15px">
      <small>விடை</small>
      <strong id="calcResult">0</strong>
    </div>
  </div>
</section>

<!-- BACKUP -->
<section id="backup" class="page">
  <h2>💾 Backup & Restore</h2>

  <div class="box">
    <p>உங்கள் கணக்குகளை ஒரு கோப்பாகச் சேமிக்கலாம்.</p>
    <button class="primary full" id="exportBtn">⬇️ Backup Download</button>

    <hr>

    <p>முன்பு சேமித்த Backup JSON கோப்பைத் தேர்ந்தெடுத்து கணக்குகளை மீட்டெடுக்கலாம்.</p>
    <input id="importFile" type="file" accept=".json,application/json">
    <button class="secondary full" id="importBtn">⬆️ Backup Restore</button>
    <p class="muted">Restore செய்வதால் தற்போதைய கணக்குகள் மாற்றப்படலாம். முதலில் Backup எடுத்துக்கொள்ளுங்கள்.</p>
  </div>
</section>

</main>

<script>
"use strict";

const STORAGE_KEY = "myHomeAccount_v1";
let accounts = [];
let editingId = null;

const $ = id => document.getElementById(id);

function escapeHTML(value){
  return String(value ?? "").replace(/[&<>"']/g, ch => ({
    "&":"&amp;",
    "<":"&lt;",
    ">":"&gt;",
    '"':"&quot;",
    "'":"&#39;"
  })[ch]);
}

function money(value){
  return Number(value || 0).toLocaleString("en-IN",{
    style:"currency",
    currency:"INR",
    minimumFractionDigits:2
  });
}

function today(){
  const d = new Date();
  const local = new Date(d.getTime() - d.getTimezoneOffset()*60000);
  return local.toISOString().slice(0,10);
}

function loadAccounts(){
  try{
    const saved = localStorage.getItem(STORAGE_KEY);
    const parsed = saved ? JSON.parse(saved) : [];
    accounts = Array.isArray(parsed) ? parsed : [];
  }catch(error){
    accounts = [];
    alert("சேமித்த கணக்குகளைப் படிக்க முடியவில்லை.");
  }
}

function saveAccounts(){
  try{
    localStorage.setItem(STORAGE_KEY, JSON.stringify(accounts));
    return true;
  }catch(error){
    alert("கணக்குகளைச் சேமிக்க முடியவில்லை. Browser storage நிரம்பியிருக்கலாம்.");
    return false;
  }
}

function showPage(pageId){
  document.querySelectorAll(".page").forEach(page=>{
    page.classList.toggle("active",page.id===pageId);
  });
  document.querySelectorAll("nav button").forEach(button=>{
    button.classList.toggle("active",button.dataset.page===pageId);
  });

  if(pageId==="home") renderHome();
  if(pageId==="history") renderHistory();
}

document.querySelectorAll("nav button").forEach(button=>{
  button.addEventListener("click",()=>showPage(button.dataset.page));
});

function totals(list=accounts){
  return list.reduce((sum,item)=>{
    const amount = Number(item.amount)||0;
    if(item.type==="income") sum.income += amount;
    else if(item.type==="expense") sum.expense += amount;
    return sum;
  },{income:0,expense:0});
}

function entryHTML(item){
  const isIncome = item.type==="income";
  return `
    <div class="entry">
      <strong>${escapeHTML(item.person)}</strong>
      <div>${escapeHTML(item.description)}</div>
      <div class="${isIncome?"green":"red"}">
        ${isIncome?"வரவு":"செலவு"}: ${money(item.amount)}
      </div>
      <div class="muted">📅 ${escapeHTML(item.date)}</div>
      ${item.notes?`<div>குறிப்பு: ${escapeHTML(item.notes)}</div>`:""}
      <button class="secondary" data-edit="${escapeHTML(item.id)}">✏️ Edit</button>
      <button class="danger" data-delete="${escapeHTML(item.id)}">🗑️ Delete</button>
    </div>
  `;
}

function renderEntries(container, list){
  container.innerHTML = list.length
    ? list.map(entryHTML).join("")
    : '<div class="box">கணக்குகள் எதுவும் இல்லை.</div>';
}

function renderHome(){
  const t = totals();
  $("incomeTotal").textContent = money(t.income);
  $("expenseTotal").textContent = money(t.expense);
  $("balanceTotal").textContent = money(t.income-t.expense);

  const recent = [...accounts].sort((a,b)=>
    (b.date||"").localeCompare(a.date||"")
  ).slice(0,5);
  renderEntries($("recentEntries"),recent);
  searchHome();
}

function searchHome(){
  const query = $("homeSearch").value.trim().toLowerCase();
  const results = accounts.filter(item=>
    [item.person,item.description,item.date,item.notes]
      .some(value=>String(value||"").toLowerCase().includes(query))
  ).sort((a,b)=>(b.date||"").localeCompare(a.date||""));

  if(!query){
    $("homeSearchResults").innerHTML =
      '<p class="muted">தேடுவதற்கு பெயர், விவரம் அல்லது தேதியை type செய்யுங்கள்.</p>';
    return;
  }
  renderEntries($("homeSearchResults"),results);
}

$("homeSearch").addEventListener("input",searchHome);

$("accountForm").addEventListener("submit",event=>{
  event.preventDefault();

  const amount = Number($("amount").value);
  if(!Number.isFinite(amount)||amount<=0){
    alert("சரியான தொகையை உள்ளிடுங்கள்.");
    return;
  }

  const item = {
    id: editingId || (Date.now().toString()+"_"+Math.random().toString(36).slice(2,8)),
    person: $("person").value.trim(),
    type: $("type").value,
    description: $("description").value.trim(),
    amount,
    date: $("date").value,
    notes: $("notes").value.trim()
  };

  if(!item.person||!item.description||!item.date){
    alert("தேவையான விவரங்களை நிரப்புங்கள்.");
    return;
  }

  const oldAccounts = [...accounts];

  if(editingId){
    accounts = accounts.map(old=>old.id===editingId?item:old);
  }else{
    accounts.push(item);
  }

  if(!saveAccounts()){
    accounts = oldAccounts;
    return;
  }

  editingId = null;
  $("accountForm").reset();
  $("date").value = today();
  $("type").value = "income";
  $("accountForm").querySelector('button[type="submit"]').textContent = "💾 கணக்கைச் சேமிக்க";

  renderHome();
  renderHistory();
  showPage("home");
  alert("கணக்கு வெற்றிகரமாகச் சேமிக்கப்பட்டது!");
});

function filteredHistory(){
  const query = $("historySearch").value.trim().toLowerCase();
  const type = $("historyType").value;
  const month = $("historyMonth").value;

  return [...accounts].filter(item=>{
    const textMatch = [item.person,item.description,item.date,item.notes]
      .some(value=>String(value||"").toLowerCase().includes(query));
    const typeMatch = type==="all"||item.type===type;
    const monthMatch = !month||String(item.date||"").startsWith(month);
    return textMatch&&typeMatch&&monthMatch;
  }).sort((a,b)=>(b.date||"").localeCompare(a.date||""));
}

function renderHistory(){
  renderEntries($("historyEntries"),filteredHistory());
}

["historySearch","historyType","historyMonth"].forEach(id=>{
  $(id).addEventListener("input",renderHistory);
  $(id).addEventListener("change",renderHistory);
});

document.addEventListener("click",event=>{
  const editButton = event.target.closest("[data-edit]");
  const deleteButton = event.target.closest("[data-delete]");

  if(editButton){
    const item = accounts.find(a=>a.id===editButton.dataset.edit);
    if(!item) return;

    editingId = item.id;
    $("person").value = item.person;
    $("type").value = item.type;
    $("description").value = item.description;
    $("amount").value = item.amount;
    $("date").value = item.date;
    $("notes").value = item.notes||"";
    $("accountForm").querySelector('button[type="submit"]').textContent = "💾 மாற்றங்களைச் சேமிக்க";
    showPage("add");
    window.scrollTo({top:0,behavior:"smooth"});
  }

  if(deleteButton){
    const id = deleteButton.dataset.delete;
    const item = accounts.find(a=>a.id===id);
    if(!item) return;

    if(confirm("இந்தக் கணக்கை நீக்க வேண்டுமா?")){
      const oldAccounts = [...accounts];
      accounts = accounts.filter(a=>a.id!==id);
      if(!saveAccounts()){
        accounts = oldAccounts;
        return;
      }
      renderHome();
      renderHistory();
    }
  }
});

$("reportBtn").addEventListener("click",()=>{
  const start = $("startDate").value;
  const end = $("endDate").value;

  if(start&&end&&start>end){
    alert("தொடக்க தேதி, முடிவு தேதிக்குப் பிறகு இருக்கக்கூடாது.");
    return;
  }

  const list = accounts.filter(item=>
    (!start||item.date>=start)&&(!end||item.date<=end)
  );
  const t = totals(list);

  $("reportResult").innerHTML = `
    <hr>
    <p>கணக்குகளின் எண்ணிக்கை: ${list.length}</p>
    <p class="green">மொத்த வரவு: ${money(t.income)}</p>
    <p class="red">மொத்த செலவு: ${money(t.expense)}</p>
    <p class="blue">மீதித் தொகை: ${money(t.income-t.expense)}</p>
  `;
});

$("calculateBtn").addEventListener("click",()=>{
  const aText = $("num1").value.trim();
  const bText = $("num2").value.trim();

  if(aText===""||bText===""){
    alert("இரண்டு எண்களையும் உள்ளிடுங்கள்.");
    return;
  }

  const a = Number(aText);
  const b = Number(bText);
  let result;

  switch($("operator").value){
    case "+": result=a+b; break;
    case "-": result=a-b; break;
    case "*": result=a*b; break;
    case "/":
      if(b===0){
        $("calcResult").textContent="பூஜ்ஜியத்தால் வகுக்க முடியாது";
        return;
      }
      result=a/b;
      break;
    default: return;
  }

  $("calcResult").textContent = Number.isFinite(result)
    ? String(Number(result.toPrecision(12)))
    : "கணக்கிட முடியவில்லை";
});

$("exportBtn").addEventListener("click",()=>{
  const blob = new Blob([JSON.stringify(accounts,null,2)],{
    type:"application/json"
  });
  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");
  link.href=url;
  link.download="home-account-backup.json";
  link.click();
  URL.revokeObjectURL(url);
});

$("importBtn").addEventListener("click",()=>{
  const file = $("importFile").files[0];
  if(!file){
    alert("முதலில் Backup JSON கோப்பைத் தேர்ந்தெடுங்கள்.");
    return;
  }

  const reader = new FileReader();
  reader.onload = ()=>{
    try{
      const data = JSON.parse(reader.result);
      if(!Array.isArray(data)) throw new Error("Invalid backup");

      const valid = data.every(item=>
        item &&
        typeof item.person==="string" &&
        typeof item.description==="string" &&
        ["income","expense"].includes(item.type) &&
        Number.isFinite(Number(item.amount)) &&
        Number(item.amount)>0 &&
        typeof item.date==="string"
      );

      if(!valid) throw new Error("Invalid account data");

      if(!confirm("தற்போதைய கணக்குகளை Backup கணக்குகளால் மாற்ற வேண்டுமா?")) return;

      const oldAccounts = [...accounts];
      accounts = data.map(item=>({
        id:String(item.id||Date.now()+"_"+Math.random().toString(36).slice(2)),
        person:item.person,
        type:item.type,
        description:item.description,
        amount:Number(item.amount),
        date:item.date,
        notes:String(item.notes||"")
      }));

      if(!saveAccounts()){
        accounts=oldAccounts;
        return;
      }

      renderHome();
      renderHistory();
      showPage("home");
      alert("Backup வெற்றிகரமாக Restore செய்யப்பட்டது!");
    }catch(error){
      alert("இந்த Backup கோப்பு சரியானது இல்லை.");
    }
  };
  reader.readAsText(file);
});

loadAccounts();
$("date").value = today();
renderHome();
renderHistory();
</script>

</body>
</html>
